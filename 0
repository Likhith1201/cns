#include <stdlib.h>
#include <string.h>
#include <stdio.h>
int main()
{
    char s[]="Hello World \0";
    int len = strlen(s);
    char op[len];
    printf("Given value: %s \n"  ,s);
    printf("Output value: ");
    for (int i = 0;i<len; i++){
        op[i] = s[i] ^ 0;
        printf("%c", op[i]);
    }
